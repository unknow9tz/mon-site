                        <Icon size={14} color={n.read ? TOKENS.sage : TOKENS.paper} />
                      </div>
                      <div className="flex-1 min-w-0">
                        <div style={{ fontSize: 12, fontWeight: n.read ? 500 : 700, color: TOKENS.ink }}>{n.text}</div>
                        <div style={{ fontSize: 11, color: TOKENS.muted, marginTop: 1 }} className="truncate">{n.detail}</div>
                        <div style={{ fontSize: 10, color: TOKENS.muted, marginTop: 2 }}>{n.time}</div>
                      </div>
                      {!n.read && <div className="w-2 h-2 rounded-full shrink-0 mt-1.5" style={{ background: TOKENS.accent }} />}
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          {/* ---------- MESSAGERIE : LISTE ---------- */}
          {view === "messages" && (
            <div>
              <div className="px-5 pt-9 pb-2">
                <div style={{ fontWeight: 800, fontSize: 18, color: TOKENS.ink }}>Messages</div>
              </div>
              <div className="px-5 flex flex-col gap-1 mt-2">
                {CONVERSATIONS.map((c) => (
                  <button key={c.id} onClick={() => { setThreadId(c.id); setView("thread"); }} className="flex items-center gap-3 p-2.5 rounded-xl text-left" style={{ background: c.unread ? TOKENS.accentSoft : "transparent" }}>
                    <div className="w-11 h-11 rounded-full shrink-0" style={{ background: c.color }} />
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center justify-between">
                        <span style={{ fontSize: 13, fontWeight: 700, color: TOKENS.ink }}>{c.name}</span>
                        <span style={{ fontSize: 10, color: TOKENS.muted }}>{c.time}</span>
                      </div>
                      <div style={{ fontSize: 11, color: c.unread ? TOKENS.ink : TOKENS.muted, fontWeight: c.unread ? 600 : 400 }} className="truncate">
                        {c.last}
                      </div>
                    </div>
                    {c.unread && <div className="w-2 h-2 rounded-full shrink-0" style={{ background: TOKENS.accent }} />}
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* ---------- MESSAGERIE : FIL ---------- */}
          {view === "thread" && thread && (
            <div className="flex flex-col h-full">
              <div className="flex items-center gap-3 px-5 pt-9 pb-2">
                <button onClick={() => setView("messages")}><ChevronLeft size={20} color={TOKENS.ink} /></button>
                <div className="w-8 h-8 rounded-full" style={{ background: thread.color }} />
                <div style={{ fontWeight: 700, fontSize: 14, color: TOKENS.ink }}>{thread.name}</div>
              </div>
              <div className="px-5 flex flex-col gap-2 mt-2">
                {thread.messages.map((m, i) => (
                  <div key={i} className="flex" style={{ justifyContent: m.from === "me" ? "flex-end" : "flex-start" }}>
                    <div className="px-3 py-2 rounded-2xl max-w-[75%]" style={{ background: m.from === "me" ? TOKENS.ink : TOKENS.card, color: m.from === "me" ? TOKENS.paper : TOKENS.ink, border: m.from === "me" ? "none" : `1px solid ${TOKENS.border}`, fontSize: 12 }}>
                      {m.text}
                    </div>
                  </div>
                ))}
                {draft && (
                  <div className="flex justify-end">
                    <div className="px-3 py-2 rounded-2xl max-w-[75%]" style={{ background: TOKENS.ink, color: TOKENS.paper, fontSize: 12 }}>{draft}</div>
                  </div>
                )}
              </div>
              <div className="mt-auto px-5 pb-3 pt-3 flex items-center gap-2">
                <input value={draft} onChange={(e) => setDraft(e.target.value)} placeholder="Écrire un message..." className="flex-1 px-3 py-2.5 rounded-xl outline-none" style={{ background: TOKENS.card, border: `1px solid ${TOKENS.border}`, fontSize: 12 }} />
                <button onClick={() => setDraft("")} className="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" style={{ background: TOKENS.accent }}>
                  <Send size={15} color="#fff" />
                </button>
              </div>
            </div>
          )}

          {/* ---------- PROFIL ---------- */}
          {view === "profile" && (
            <div className="px-5 pt-9">
              <div className="flex items-center justify-between">
                <div style={{ fontWeight: 800, fontSize: 18, color: TOKENS.ink }}>Profil</div>
                <button onClick={() => setView("login")} style={{ fontSize: 11, fontWeight: 700, color: TOKENS.inkSoft }}>
                  Se déconnecter
                </button>
              </div>
              <div className="flex items-center gap-3 mt-4">
                <div className="w-16 h-16 rounded-full" style={{ background: PROFILE.color }} />
                <div>
                  <div style={{ fontWeight: 700, fontSize: 15, color: TOKENS.ink }}>{PROFILE.name}</div>
                  <div className="flex items-center gap-1" style={{ fontSize: 12, color: TOKENS.muted }}>
                    <Star size={12} color={TOKENS.accent} fill={TOKENS.accent} /> {PROFILE.rating} · {PROFILE.sales} ventes
                  </div>
                </div>
              </div>

              <p style={{ fontSize: 12, color: TOKENS.inkSoft, lineHeight: 1.6, marginTop: 14 }}>
                {PROFILE.bio}
              </p>

              <div className="flex gap-2 mt-5">
                <button onClick={() => setProfileTab("annonces")} className="px-3 py-1.5 rounded-full" style={{ background: profileTab === "annonces" ? TOKENS.ink : TOKENS.card, color: profileTab === "annonces" ? TOKENS.paper : TOKENS.inkSoft, border: `1px solid ${profileTab === "annonces" ? TOKENS.ink : TOKENS.border}`, fontSize: 12, fontWeight: 600 }}>
                  Mes annonces
                </button>
                <button onClick={() => setProfileTab("favoris")} className="px-3 py-1.5 rounded-full" style={{ background: profileTab === "favoris" ? TOKENS.ink : TOKENS.card, color: profileTab === "favoris" ? TOKENS.paper : TOKENS.inkSoft, border: `1px solid ${profileTab === "favoris" ? TOKENS.ink : TOKENS.border}`, fontSize: 12, fontWeight: 600 }}>
                  Favoris ({favs.size})
                </button>
                <button onClick={() => setProfileTab("avis")} className="px-3 py-1.5 rounded-full" style={{ background: profileTab === "avis" ? TOKENS.ink : TOKENS.card, color: profileTab === "avis" ? TOKENS.paper : TOKENS.inkSoft, border: `1px solid ${profileTab === "avis" ? TOKENS.ink : TOKENS.border}`, fontSize: 12, fontWeight: 600 }}>
                  Avis ({REVIEWS.length})
                </button>
              </div>

              {profileTab !== "avis" && (
                <div className="grid grid-cols-2 gap-3 mt-4">
                  {(profileTab === "annonces" ? PRODUCTS.filter((p) => p.seller === "Camille") : PRODUCTS.filter((p) => favs.has(p.id))).map((p) => (
                    <ProductCard key={p.id} p={p} isFav={favs.has(p.id)} onToggleFav={toggleFav} onOpen={openProduct} />
                  ))}
                  {profileTab === "favoris" && favs.size === 0 && (
                    <div className="col-span-2 text-center py-8" style={{ color: TOKENS.muted, fontSize: 12 }}>
                      Touche le cœur d'une annonce pour la retrouver ici.
                    </div>
                  )}
                </div>
              )}

              {profileTab === "avis" && (
                <div className="mt-4">
                  <div className="flex items-center gap-3 p-3 rounded-xl" style={{ background: TOKENS.sageSoft }}>
                    <div style={{ fontFamily: "'Space Mono', monospace", fontWeight: 700, fontSize: 26, color: TOKENS.sage }}>{PROFILE.rating}</div>
                    <div>
                      <div className="flex items-center gap-0.5">
                        {[1, 2, 3, 4, 5].map((i) => (
                          <Star key={i} size={12} color={TOKENS.sage} fill={i <= Math.round(PROFILE.rating) ? TOKENS.sage : "none"} />
                        ))}
                      </div>
                      <div style={{ fontSize: 11, color: TOKENS.inkSoft, marginTop: 2 }}>{REVIEWS.length} avis vérifiés · {PROFILE.sales} ventes</div>
                    </div>
                  </div>

                  <div className="flex flex-col gap-3 mt-4">
                    {REVIEWS.map((r) => (
                      <div key={r.id} className="p-3 rounded-xl" style={{ background: TOKENS.card, border: `1px solid ${TOKENS.border}` }}>
                        <div className="flex items-center gap-2">
                          <div className="w-8 h-8 rounded-full shrink-0" style={{ background: r.color }} />
                          <div className="flex-1">
                            <div style={{ fontSize: 12, fontWeight: 700, color: TOKENS.ink }}>{r.name}</div>
                            <div style={{ fontSize: 10, color: TOKENS.muted }}>{r.product} · {r.date}</div>
                          </div>
                          <div className="flex items-center gap-0.5 shrink-0">
                            {[1, 2, 3, 4, 5].map((i) => (
                              <Star key={i} size={10} color={TOKENS.accent} fill={i <= r.rating ? TOKENS.accent : "none"} />
                            ))}
                          </div>
                        </div>
                        <p style={{ fontSize: 12, color: TOKENS.inkSoft, lineHeight: 1.5, marginTop: 8 }}>{r.text}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          {/* ---------- VENDRE ---------- */}
          {view === "sell" && !published && (
            <div className="px-5 pt-9">
              <div className="flex items-center gap-3">
                <button onClick={() => setView("browse")}><ChevronLeft size={20} color={TOKENS.ink} /></button>
                <div style={{ fontWeight: 800, fontSize: 18, color: TOKENS.ink }}>Déposer une annonce</div>
              </div>

              <div className="grid grid-cols-4 gap-2 mt-5">
                <div className="aspect-square rounded-xl flex flex-col items-center justify-center gap-1" style={{ background: TOKENS.card, border: `2px dashed ${TOKENS.accent}` }}>
                  <Camera size={16} color={TOKENS.accent} />
                  <span style={{ fontSize: 9, color: TOKENS.accent, fontWeight: 700 }}>Ajouter</span>
                </div>
                {[1, 2, 3].map((i) => (
                  <div key={i} className="aspect-square rounded-xl" style={{ background: TOKENS.card, border: `1px dashed ${TOKENS.border}` }} />
                ))}
              </div>
              <div style={{ fontSize: 11, color: TOKENS.muted, marginTop: 6 }}>
                4 photos min. recommandées — les annonces bien illustrées se vendent plus vite.
              </div>

              <div className="mt-5">
                <label style={{ fontSize: 11, fontWeight: 700, color: TOKENS.inkSoft }}>TITRE</label>
                <input value={sellTitle} onChange={(e) => setSellTitle(e.target.value)} placeholder="Ex. Pull en laine col rond" className="w-full mt-1 px-3 py-2.5 rounded-xl outline-none" style={{ background: TOKENS.card, border: `1px solid ${TOKENS.border}`, fontSize: 13 }} />
              </div>

              <div className="mt-4">
                <label style={{ fontSize: 11, fontWeight: 700, color: TOKENS.inkSoft }}>CATÉGORIE</label>
                <div className="flex gap-2 mt-1.5 flex-wrap">
                  {CATEGORIES.filter((c) => c !== "Tout").map((c) => (
                    <button key={c} onClick={() => setSellCat(c)} className="px-3 py-1.5 rounded-full" style={{ background: sellCat === c ? TOKENS.ink : TOKENS.card, color: sellCat === c ? TOKENS.paper : TOKENS.inkSoft, border: `1px solid ${sellCat === c ? TOKENS.ink : TOKENS.border}`, fontSize: 12, fontWeight: 600 }}>
                      {c}
                    </button>
                  ))}
                </div>
              </div>

              <div className="mt-4">
                <label style={{ fontSize: 11, fontWeight: 700, color: TOKENS.inkSoft }}>ÉTAT</label>
                <div className="flex gap-2 mt-1.5 flex-wrap">
                  {STATES.map((s) => (
                    <button key={s} onClick={() => setSellState(s)} className="px-3 py-1.5 rounded-full" style={{ background: sellState === s ? TOKENS.sageSoft : TOKENS.card, color: sellState === s ? TOKENS.sage : TOKENS.inkSoft, border: `1px solid ${sellState === s ? TOKENS.sage : TOKENS.border}`, fontSize: 11, fontWeight: 600 }}>
                      {s}
                    </button>
                  ))}
                </div>
              </div>

              <div className="mt-4">
                <label style={{ fontSize: 11, fontWeight: 700, color: TOKENS.inkSoft }}>PRIX</label>
                <div className="flex items-center mt-1 px-3 py-2.5 rounded-xl" style={{ background: TOKENS.card, border: `1px solid ${TOKENS.border}` }}>
                  <input value={sellPrice} onChange={(e) => setSellPrice(e.target.value.replace(/[^0-9]/g, ""))} placeholder="0" className="w-full bg-transparent outline-none" style={{ fontFamily: "'Space Mono', monospace", fontSize: 16, fontWeight: 700, color: TOKENS.ink }} />
                  <span style={{ fontFamily: "'Space Mono', monospace", fontSize: 16, color: TOKENS.muted }}>€</span>
                </div>
              </div>

              <div className="flex items-start gap-2 mt-4 p-3 rounded-xl" style={{ background: TOKENS.accentSoft }}>
                <Sparkles size={14} color={TOKENS.accent} className="mt-0.5 shrink-0" />
                <span style={{ fontSize: 11, color: TOKENS.ink }}>{TIPS[sellCat]}</span>
              </div>

              <div className="flex items-center justify-between mt-4 p-3 rounded-xl" style={{ background: TOKENS.card, border: `1px solid ${TOKENS.border}` }}>
                <div>
                  <div style={{ fontSize: 12, fontWeight: 700, color: TOKENS.ink }}>Mettre en avant</div>
                  <div style={{ fontSize: 10, color: TOKENS.muted }}>+3x de visibilité, gratuit 48h</div>
                </div>
                <button onClick={() => setBoost((b) => !b)} className="w-10 h-6 rounded-full relative shrink-0" style={{ background: boost ? TOKENS.accent : TOKENS.border }}>
                  <div className="absolute top-0.5 w-5 h-5 rounded-full bg-white transition-all" style={{ left: boost ? 18 : 2 }} />
                </button>
              </div>

              <button onClick={() => setPublished(true)} disabled={!sellTitle || !sellPrice} className="w-full mt-5 py-3.5 rounded-xl" style={{ background: !sellTitle || !sellPrice ? TOKENS.border : TOKENS.ink, color: TOKENS.paper, fontWeight: 700, fontSize: 14 }}>
                Publier l'annonce
              </button>
            </div>
          )}

          {view === "sell" && published && (
            <div className="px-5 pt-9 flex flex-col items-center text-center">
              <div className="w-full flex justify-start">
                <button onClick={() => setView("browse")}><ChevronLeft size={20} color={TOKENS.ink} /></button>
              </div>
              <div className="mt-10 w-16 h-16 rounded-full flex items-center justify-center" style={{ background: TOKENS.sageSoft }}>
                <Sparkles size={26} color={TOKENS.sage} />
              </div>
              <div style={{ fontWeight: 800, fontSize: 18, color: TOKENS.ink, marginTop: 16 }}>Annonce publiée !</div>
              <p style={{ fontSize: 12, color: TOKENS.muted, marginTop: 6, maxWidth: 250, lineHeight: 1.6 }}>
                "{sellTitle}" est en ligne{boost ? " et mise en avant pour 48h" : ""}. Tu recevras une notification à chaque message.
              </p>
              <button onClick={() => { setPublished(false); setSellTitle(""); setSellPrice(""); setView("browse"); }} className="mt-6 px-5 py-2.5 rounded-xl" style={{ background: TOKENS.ink, color: TOKENS.paper, fontWeight: 700, fontSize: 13 }}>
                Retour aux annonces
              </button>
            </div>
          )}
        </div>

        {/* ---------- NAV BAS ---------- */}
        {!["login", "signup"].includes(view) && (
        <div className="absolute bottom-0 left-0 right-0 flex items-center justify-around py-3 px-2" style={{ background: TOKENS.card, borderTop: `1px solid ${TOKENS.border}` }}>
          <button onClick={() => setView("browse")} className="flex flex-col items-center gap-0.5">
            <Home size={18} color={["browse", "detail", "checkout", "visualSearch", "notifications"].includes(view) ? TOKENS.ink : TOKENS.muted} />
            <span style={{ fontSize: 9, color: ["browse", "detail", "checkout", "visualSearch", "notifications"].includes(view) ? TOKENS.ink : TOKENS.muted, fontWeight: 600 }}>Accueil</span>
          </button>
          <button onClick={() => setView("profile")} className="flex flex-col items-center gap-0.5">
            <Heart size={18} color={TOKENS.muted} fill={favs.size ? TOKENS.accent : "none"} stroke={favs.size ? TOKENS.accent : TOKENS.muted} />
            <span style={{ fontSize: 9, color: TOKENS.muted, fontWeight: 600 }}>Favoris ({favs.size})</span>
          </button>
          <button onClick={() => { setView("sell"); setPublished(false); }} className="w-11 h-11 rounded-full flex items-center justify-center -mt-6" style={{ background: TOKENS.accent, boxShadow: `0 6px 16px ${TOKENS.accentSoft}` }}>
            <Plus size={22} color="#fff" />
          </button>
          <button onClick={() => setView("messages")} className="flex flex-col items-center gap-0.5 relative">
            <MessageCircle size={18} color={["messages", "thread"].includes(view) ? TOKENS.ink : TOKENS.muted} />
            {CONVERSATIONS.some((c) => c.unread) && <span className="absolute top-0 right-1 w-2 h-2 rounded-full" style={{ background: TOKENS.accent }} />}
            <span style={{ fontSize: 9, color: ["messages", "thread"].includes(view) ? TOKENS.ink : TOKENS.muted, fontWeight: 600 }}>Messages</span>
          </button>
          <button onClick={() => setView("profile")} className="flex flex-col items-center gap-0.5">
            <User size={18} color={view === "profile" ? TOKENS.ink : TOKENS.muted} />
            <span style={{ fontSize: 9, color: view === "profile" ? TOKENS.ink : TOKENS.muted, fontWeight: 600 }}>Profil</span>
          </button>
        </div>
        )}
      </div>
    </div>
  );
}

const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(<FriperieApp />);
</script>
</body>
</html>
